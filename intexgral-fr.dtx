%    \begin{macrocode}
\NewDocumentCommand\ProvideSymbolKeyword{ m m }
   {
      \prop_if_in:NnT \g_@@_limits_keyword_prop { #1 }
         { \msg_warning:nnn { intexgral } { key-exists-for-lim } { #1 } }
      \keys_if_exist:nnF { integral } { #1 }
         {
            \keys_define:nn { integral }
               {
                  #1 .meta:n =
                     {
                        symbol=#2,
                        llimit=##1
                     },
               }
         }
   }
%    \end{macrocode}
