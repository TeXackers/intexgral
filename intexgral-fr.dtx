\tl_new:N \l_@@_default_differential_symbol_tl
%    \end{macrocode}
% \end{codedescribe}
%
% \begin{codedescribe}[variable3]{\l_@@_limits_style_tl}
% Contient la primitive \TeX\ à utiliser pour le style des bornes.
