\input regression-test.tex

\documentclass{article}

\usepackage{intexgral}
\usepackage{mathtools}
\usepackage{pkginfograb}
\PkgInfoSetAliases

\ExplSyntaxOn
\sys_if_engine_pdftex:F
  { \usepackage{unicode-math} }
\ExplSyntaxOff

\setlength{\parindent}{0pt}

\begin{document}

\begin{center}
  \scshape\huge
  this is a test file
\end{center}

\PkgInfoDescription{intexgral}

Simple test

\begin{equation}
  \integral{x}
\end{equation}

Key \texttt{limits} test

\begin{gather}
  \integral[limits={a, b}]{x}\\
  \integral[limits={a, b; c, d; e, f}]{x}
\end{gather}

Key \texttt{limits*} test

\begin{gather}
  \integral[limits*={a, b}]{x}\\
  \integral[limits*={a, b; c, d; e, f}]{x}
\end{gather}

Key \texttt{mode} test

\begin{gather}
  \integral[limits={a, b; c, d; e, f}, variables={f, g, h}, mode=default]{f^2g^3h^4}\\
  \integral[limits={a, b; c, d; e, f}, variables={f, g, h}, mode=nested]{f^2;g^3;h^4}\\
  \integral[limits={a, b; c, d; e, f}, variables={f, g, h}, mode=product]{f^2;g^3;h^4}
\end{gather}

Key \texttt{symbol} test

\begin{gather}
  \integral[symbol=\iint]{x}\\
  \integral[symbol=\foo]{x} % warning expected
\end{gather}

Key \texttt{nint} test

\begin{equation}
  \integral[nint=5]{x}
\end{equation}

Keys \texttt{llimit} and \texttt{ulimit} test

\begin{gather}
  \integral[llimit=X]{x}\\
  \integral[ulimit=X]{x}
\end{gather}

Key \texttt{domain(*)} test

\begin{gather}
  \integral[domain={r*z}]{x}\\
  \integral[domain={r2*z5*c9}]{x}\\
  \integral[domain*={r*zp}]{x}\\
  \integral[domain*={Ei*At}]{x}
\end{gather}

Key \texttt{boundary} test

\begin{equation}
  \integral[boundary=S]{x}
\end{equation}

Key \texttt{variables} test

\begin{gather}
  \integral[limits={ab;ab;ab}, variables={x, y, z}]{xyz}\\
  \integral[variables=none]{x}
\end{gather}

Key \texttt{jacobian} test

\begin{gather}
  \integral[limits={ab;ab}, variables=polar, jacobian=true]{r^3 \sqrt\theta}\\
  \integral[limits={ab;ab;ab}, variables=spherical, jacobian=true]{r^3 \sqrt\theta e^\phi}
\end{gather}

Key \texttt{diff-symb} test

\NewDifferential{\feynmandiff}{\mathcal{D}}

\begin{equation}
  \integral[diff-symb=\feynmandiff, variables={q(t)}]{x}
\end{equation}

Key \texttt{diff-star} test

\begin{equation}
  \integral[diff-star=true, variables={x, y}]{x}
\end{equation}

Key \texttt{diff-options} test

\begin{gather}
  \integral[diff-options={order=4}]{x}\\
  \integral[limits={ab;ab;ab}, variables=spherical, mode=product, diff-options={order={2, 4, 6}, var={1, 3}, style-inf=\mathbf{d}}]{r; \theta; \phi}
\end{gather}

Macro \verb|\NewLimitsKeyword| test

\NewLimitsKeyword{test}{\text{lower}, \text{upper}}

\begin{equation}
  \integral[limits=test]{x}
\end{equation}

Macro \verb|\NewVariableKeyword| test

\NewVariableKeyword{test}{\alpha, \beta, \gamma}

\begin{equation}
  \integral[limits={ab;ab;ab}, variables=test]{x}
\end{equation}

Macro \verb|\NewSymbolKeyword|

\NewSymbolKeyword{test}{\intclockwise}

\begin{equation}
  \integral[test=S]{x}
\end{equation}

Macro \verb|\differentials| test

\begin{equation}
  \integral{\frac\differentials x}
\end{equation}

Special syntax test

\begin{gather}
  \integral[1, 10]{x}\\
  \integral[ab;ab;ab:spherical+j:p]{r;\theta;\phi}
\end{gather}

\IntegralSetup{defaultvar=spherical}

\begin{gather}
  \integral[ab;ab;ab:spherical+j:p]{;;}\\
  \integral[ab;ab;ab:+j:p]{;;}
\end{gather}

Messages test

\begin{gather}
  \integral[ab;ab:x,y,z:p]{x}\\
  \integral[ab;ab:x,y,z+j]{x}\\
  \integral[ab;ab:x,y:n]{\frac 1x; \frac\differentials y}\\
\end{gather}

\end{document}