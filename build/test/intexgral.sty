    \tl_set:Ne \l_tmpa_tl { \clist_item:Nn \l_tmpa_clist { 1 } }
    \tl_if_in:NnTF \l_tmpa_tl { = }
      {
        \tl_set:Ne \l__intexgral_key_name_tl
          {
            \exp_last_unbraced:NV
            \__intexgral_retrieve_key_name:w \l_tmpa_tl \q_stop
          }
      }
      { \tl_set_eq:NN \l__intexgral_key_name_tl \l_tmpa_tl }
  }


\cs_new_protected:Npn \__intexgral_parse_macro_keys:n #1
  {
    \keys_if_exist:nVTF { integral } \l__intexgral_key_name_tl
      { \keys_set:nn { integral } { #1 } }
      {
        \regex_split:nnN { : } { #1 } \l_tmpa_seq
        \str_if_eq:eeTF
          { \seq_item:Nn \l_tmpa_seq { 2 } }
          { +j }
          {
            \exp_args:NNne \seq_set_item:Nnn \l_tmpa_seq { 2 }
              { \l__intexgral_default_differential_tl+j }
          }
          {
            \int_compare:nNnT { \seq_count:N \l_tmpa_seq } < { 2 }
              {
                \seq_put_right:NV
                  \l_tmpa_seq
                  \l__intexgral_default_differential_tl
              }
          }
        \int_compare:nNnT { \seq_count:N \l_tmpa_seq } < { 3 }
          { \seq_put_right:Nn \l_tmpa_seq { d } }
        \seq_set_split:Nne \l_tmpb_seq
          { + }
          { \seq_item:Nn \l_tmpa_seq { 2 } }
        \keys_set:ne { integral }
          {
            limits    = { \seq_item:Nn \l_tmpa_seq { 1 } },
            variables = { \seq_item:Nn \l_tmpb_seq { 1 } },
            mode      =
              {
                \str_case:enF { \seq_item:Nn \l_tmpa_seq { 3 } }
                  {
                    { d       } { default }
                    { n       } { nested  }
                    { p       } { product }
                    { default } { default }
                    { nested  } { nested  }
                    { product } { product }
                  }
                { default }
              },
            \bool_if:nT
              {
                \int_compare_p:nNn { \seq_count:N \l_tmpb_seq } > { 1 }
                &&
                \str_if_eq_p:en { \seq_item:Nn \l_tmpb_seq { 2 } } { j }
              }
              { jacobian }
          }
      }
  }



\cs_new_protected:Nn \__intexgral_check_sequence_size:
  {
    \int_compare:nNnTF
      { \seq_count:N \l__intexgral_integral_symbol_seq }
      =
      { \seq_count:N \l__intexgral_integrand_seq }
        {
          \int_compare:nNnF
            { \seq_count:N \l__intexgral_integrand_seq }
            =
            { \seq_count:N \l__intexgral_differential_seq }
              {
                \msg_warning:nneee { intexgral } { unequal-dim }
                  { \seq_count:N \l__intexgral_integral_symbol_seq }
                  { \seq_count:N \l__intexgral_integrand_seq       }
                  { \seq_count:N \l__intexgral_differential_seq    }
              }
        }
        {
          \msg_warning:nneee { intexgral } { unequal-dim }
            { \seq_count:N \l__intexgral_integral_symbol_seq }
            { \seq_count:N \l__intexgral_integrand_seq       }
            { \seq_count:N \l__intexgral_differential_seq    }
        }
  }


\cs_new_protected:Nn \__intexgral_integral_preconfiguration:
  {
    \int_gincr:N \g__intexgral_integral_number_int

    \bool_if:NT \l__intexgral_separate_integral_bool
      {
        \seq_set_split:NnV
          \l__intexgral_integrand_seq
          { ; }
          \l__intexgral_integrand_tl
      }

    \seq_if_empty:NT \l__intexgral_integral_symbol_seq
      {
        \seq_put_right:Nn \l__intexgral_integral_symbol_seq
          { \__intexgral_parse_integral_symbol: }
      }

    \seq_if_empty:NT \l__intexgral_integrand_seq
      {
        \seq_put_right:NV
          \l__intexgral_integrand_seq
          \l__intexgral_integrand_tl
      }

    \bool_if:NF \l__intexgral_deactivate_differentials_bool
      { \__intexgral_parse_differentials: }

    \regex_if_match:nVTF { \c{differentials} } \l__intexgral_integrand_tl
      { \bool_set_true:N \l__intexgral_manual_differentials_bool }
      { \bool_set_false:N \l__intexgral_manual_differentials_bool }

    \bool_if:NT \l__intexgral_separate_integral_bool
      { \__intexgral_check_sequence_size: }
  }


\cs_new_protected:Nn \__intexgral_print_default_integral:
  {
    \bool_if:NT \l__intexgral_manual_differentials_bool
      {
        \cs_set_protected:Npn \differentials
          { \seq_use:Nn \l__intexgral_differential_seq {  } }
      }
    \seq_use:Nn \l__intexgral_integral_symbol_seq
      { \__intexgral_mkern:N \l__intexgral_inline_symbol_muskip }
    \bool_if:nT
      {
        \l__intexgral_invert_differentials_bool
        &&
        !\l__intexgral_manual_differentials_bool
      }
      {
        \seq_use:Nn \l__intexgral_differential_seq {  } \tex_mathop:D{} \!
        \bool_if:NT \l__intexgral_vectorial_differential_bool { \cdot \: }
      }
    \seq_use:Nn \l__intexgral_integrand_seq {  }
    \bool_if:NT \l__intexgral_jacobian_bool
      { \seq_use:Nn \l__intexgral_jacobian_seq {  } }
    \bool_if:nT
      {
        !\l__intexgral_invert_differentials_bool
        &&
        !\l__intexgral_manual_differentials_bool
      }
      {
        \bool_if:NT \l__intexgral_vectorial_differential_bool { \cdot }
        \seq_use:Nn \l__intexgral_differential_seq {  }
      }
  }


\cs_new_protected:Nn \__intexgral_print_nested_integral:
  {
    \bool_if:NT \l__intexgral_manual_differentials_bool
      {
        \cs_set_protected:Npn \differentials
          { \seq_use:Nn \l__intexgral_differential_seq {  } }
      }
    \bool_if:NT \l__intexgral_vectorial_differential_bool
      { \msg_warning:nnn { intexgral } { diff-vec-not-supp } { nested } }
    \int_step_inline:nn { \seq_count:N \l__intexgral_integral_symbol_seq }
      {
        \seq_item:Nn \l__intexgral_integral_symbol_seq { ##1 }
        \bool_if:NTF \l__intexgral_invert_differentials_bool
          {
            \bool_if:NT \l__intexgral_manual_differentials_bool
              {
                \msg_warning:nn { intexgral } { diff-not-sup }
                \cs_set_eq:NN \differentials \scan_stop:
              }
            \seq_item:Nn \l__intexgral_differential_seq { ##1 }
            \tex_mathop:D{} \!
          }
          {
            \seq_item:Nn \l__intexgral_integrand_seq { ##1 }
            \bool_if:NT \l__intexgral_jacobian_bool
              { \seq_item:Nn \l__intexgral_jacobian_seq { ##1 } }
          }
      }
    \bool_if:NTF \l__intexgral_invert_differentials_bool
      {
        \seq_use:Nn \l__intexgral_integrand_seq {}
        \bool_if:NT \l__intexgral_jacobian_bool
          { \seq_use:Nn \l__intexgral_jacobian_seq {  } }
      }
      {
        \bool_if:NF \l__intexgral_manual_differentials_bool
          {
            \seq_use:Nn \l__intexgral_differential_seq {}
          }
      }
  }


\cs_new_protected:Nn \__intexgral_print_product_integral:
  {
    \bool_if:NT \l__intexgral_manual_differentials_bool
      {
        \cs_set_protected:Npn \differentials
          {
            \seq_gpop_left:NN \l_tmpa_tl
            \tl_use:N \l_tmpa_tl
          }
      }
    \bool_if:NT \l__intexgral_vectorial_differential_bool
      { \msg_warning:nnn { intexgral } { diff-vec-not-supp } { product } }
    \int_step_inline:nn { \seq_count:N \l__intexgral_integral_symbol_seq }
      {
        \seq_item:Nn \l__intexgral_integral_symbol_seq { ##1 }
        \bool_if:nT
          {
            \l__intexgral_invert_differentials_bool
            &&
            !\l__intexgral_manual_differentials_bool
          }
          {
            \seq_item:Nn
              \l__intexgral_differential_seq { ##1 }
            \tex_mathop:D{} \!
          }
      \seq_item:Nn \l__intexgral_integrand_seq { ##1 }
      \bool_if:NT \l__intexgral_jacobian_bool
        { \seq_item:Nn \l__intexgral_jacobian_seq { ##1 } }
      \bool_if:nT
        {
          !\l__intexgral_invert_differentials_bool
          &&
          !\l__intexgral_manual_differentials_bool
        }
        { \seq_item:Nn \l__intexgral_differential_seq { ##1 } }
      }
  }


\cs_new_protected:Nn \__intexgral_print_integral:
  {
    \__intexgral_integral_preconfiguration:
    \str_case:VnF \l__intexgral_display_mode_str
      {
        { default } { \__intexgral_print_default_integral: }
        { nested  } { \__intexgral_print_nested_integral:  }
        { product } { \__intexgral_print_product_integral: }
      }
      { \__intexgral_print_default_integral: }
    \seq_gclear:N \l__intexgral_differential_seq
  }


\keys_define:nn { integral } {

  % LIMITS

  mode .choice:,
    mode / default .code:n =
      {
        \bool_set_false:N \l__intexgral_separate_integral_bool
        \str_set:Nn \l__intexgral_display_mode_str { default }
      },
    mode / nested .code:n =
      {
        \bool_set_true:N \l__intexgral_separate_integral_bool
        \str_set:Nn \l__intexgral_display_mode_str { nested }
      },
    mode / product .code:n =
      {
        \bool_set_true:N \l__intexgral_separate_integral_bool
        \str_set:Nn \l__intexgral_display_mode_str { product }
      },
    mode .default:n = { default },

  limits .code:n =
    {
      \__intexgral_parse_limits:n { #1 }
      \__intexgral_set_limits_regular:
      \__intexgral_generate_integral_sequence:
    },

  limits* .code:n =
    {
      \__intexgral_parse_limits:n { #1 }
      \__intexgral_set_limits_starred:
      \__intexgral_generate_integral_sequence:
    },

  llimit .tl_set:N = \l__intexgral_lower_limit_tl,

  ulimit .tl_set:N = \l__intexgral_upper_limit_tl,

  symbol .code:n =
    {
      \cs_if_exist:NTF #1
        { \tl_set_eq:NN \l__intexgral_integral_symbol_tl #1 }
        {
          \msg_warning:nnn { intexgral } { unknown-symb } { #1 }
          \tl_set_eq:NN \l__intexgral_integral_symbol_tl \int
        }
    },

  % SYMBOL SHORTCUT

  nint .code:n =
    {
      \int_compare:nNnT { #1 } < { 5 }
        { \msg_warning:nn { intexgral } { use-glyph-instead } }

      \tl_clear:N \l__intexgral_integral_symbol_tl

      \int_step_inline:nn { #1 }
        {
          \tl_put_right:Nn \l__intexgral_integral_symbol_tl
            { \int }
          \int_compare:nNnT { ##1 } < { #1 }
            {
              \tl_put_right:Nn \l__intexgral_integral_symbol_tl
                {
                  \__intexgral_mathchoice:nnnn
                    { \tex_mkern:D -12mu \scan_stop: }
                    { \tex_mkern:D -8mu \scan_stop: }
                    { \tex_mkern:D -4mu \scan_stop: }
                    { \tex_mkern:D -2mu \scan_stop: }
                }
            }
        }
    },

  % LIMITS SHORTCUTS

  domain .code:n =
    {
      \tl_set:Nn \l_tmpa_tl { #1 }
      \seq_set_split:NnV \l__intexgral_domain_seq { * } \l_tmpa_tl
      \seq_map_inline:Nn \l__intexgral_domain_seq
        {
          \tl_if_empty:NF \l__intexgral_lower_limit_tl
            { \tl_put_right:Nn \l__intexgral_lower_limit_tl { \times } }
          \tl_set:Ne \l__intexgral_domain_char_tl
            { \exp_args:Ne \str_uppercase:n { \tl_head:n { ##1 } } }
          \tl_set:Ne \l__intexgral_domain_dimension_tl
            { \tl_tail:n { ##1 } }
          \tl_put_right:Ne \l__intexgral_lower_limit_tl
            {
              \exp_not:N \l__intexgral_domain_style_tl
                { \l__intexgral_domain_char_tl }
              \c_math_superscript_token { \l__intexgral_domain_dimension_tl }
            }
        }
    },

  domain* .code:n =
    {
      \tl_set:Nn \l_tmpa_tl { #1 }
      \seq_set_split:NnV \l__intexgral_domain_seq { * } \l_tmpa_tl
      \seq_map_inline:Nn \l__intexgral_domain_seq
        {
          \tl_if_empty:NF \l__intexgral_lower_limit_tl
            { \tl_put_right:Nn \l__intexgral_lower_limit_tl { \times } }
          \tl_set:Ne \l__intexgral_domain_char_tl
            { \exp_args:Ne \str_uppercase:n { \tl_head:n { ##1 } } }
          \tl_set:Ne \l__intexgral_domain_dimension_tl
            { \tl_tail:n { ##1 } }
          \tl_put_right:Ne \l__intexgral_lower_limit_tl
            {
              \exp_not:N \l__intexgral_domain_style_tl
                { \l__intexgral_domain_char_tl }
              \c_math_subscript_token { \l__intexgral_domain_dimension_tl }
            }
        }
    },

  boundary .code:n =
    { \tl_set:Nn \l__intexgral_lower_limit_tl { \partial #1 } },

  % VARIABLES

  variables .code:n =
    {
      \bool_set_true:N \l__intexgral_custom_variables_bool
      \str_if_eq:nnTF { #1 } { none }
        { \bool_set_true:N \l__intexgral_deactivate_differentials_bool }
        {
          \prop_get:NnNTF
            \g__intexgral_differential_group_keyword_prop { #1 } \l_tmpa_tl
              {
                \clist_set:NV \l__intexgral_variable_i_clist \l_tmpa_tl
                \seq_if_exist:cTF { g__intexgral_#1_jacobian_seq }
                  {
                    \seq_set_eq:Nc
                      \l__intexgral_jacobian_seq
                      { g__intexgral_#1_jacobian_seq }
                  }
                  { \msg_warning:nnn { intexgral } { no-jacobian } { #1 } }
              }
              { \clist_set:Nn \l__intexgral_variable_i_clist { #1 } }
        }
    },

  jacobian .code:n =
    { \bool_set_true:N \l__intexgral_jacobian_bool },
  diff-vec .code:n =
    { \bool_set_true:N \l__intexgral_vectorial_differential_bool },
  diff-star .code:n =
    { \bool_set_true:N \l__intexgral_starred_differential_bool },

  diff-symb .code:n =
    {
      \cs_set:Npn \__intexgral_differentials:nn ##1##2 {
        \bool_if:NTF \l__intexgral_starred_differential_bool
          { #1*[##1]{##2} }
          { #1[##1]{##2} }
      }
    },

  diff-options .tl_set:N = \l__intexgral_differential_options_i_tl,
}

